# --- Project Configuration ---
PROJECT_NAME="<%project_name%>"

# --- LLM Provider Choice ---
LLM_PROVIDER=<%llm_provider%>

{% if llm_provider == 'openai' %}
# --- OpenAI Settings ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_NAME=gpt-4o
OPENAI_API_BASE=https://api.openai.com/v1

{% elif llm_provider == 'azure' %}
# --- Azure OpenAI Settings ---
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

{% elif llm_provider == 'deepseek' %}
# --- DeepSeek Settings ---
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

{% elif llm_provider == 'gemini' %}
# --- Google Gemini Settings ---
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-1.5-pro

{% elif llm_provider == 'claude' %}
# --- Anthropic Claude Settings ---
ANTHROPIC_API_KEY=your_claude_api_key
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20240620
ANTHROPIC_API_URL=

{% elif llm_provider == 'local' %}
# --- Local LLM Settings ---
LOCAL_LLM_ENDPOINT=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
{% endif %}

# --- Database & Storage ---
DATABASE_DRIVER=postgresql-async
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DBNAME=backend
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin
DATABASE_SCHEMA=public

# Legacy or Direct URL access
DB_URL=postgresql+asyncpg://admin:admin@localhost:5432/backend
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200

# --- MCP Server Configuration ---
AX_MCP_SERVER_URL=http://127.0.0.1:8080/mcp
AX_MCP_SERVER_API_KEY=dummy_mcp_key
AX_MCP_SERVER_NAME=aix-mcp-remote
AX_MCP_PROMPT_ENABLED=False
AX_MCP_PROMPT_MARI_TAG_GROUP="<%project_name%>"

# --- Langfuse Tracing ---
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# --- Security & Authentication ---
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Authelia Configuration (Optional) ---
# AUTHELIA_URL=https://auth.example.com
# AUTHELIA_INTROSPECTION_URL=http://authelia:9091/api/oidc/introspection
# AUTHELIA_TOKEN_URL=http://authelia:9091/api/oidc/token
# AUTHELIA_USERINFO_URL=http://authelia:9091/api/oidc/userinfo
# AUTHELIA_AUTHORIZATION_URL=https://auth.example.com/api/oidc/authorization
# AUTHELIA_CLIENT_ID=fastapi
# AUTHELIA_CLIENT_SECRET=your-secret
# AUTHELIA_REDIRECT_URI=http://localhost:8888/api/v1/auth/callback
