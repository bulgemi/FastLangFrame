# LLM Provider Configuration
LLM_PROVIDER={% if llm_provider == 'azure' %}azure{% elif llm_provider == 'openai' %}openai{% elif llm_provider == 'deepseek' %}deepseek{% elif llm_provider == 'gemini' %}gemini{% elif llm_provider == 'claude' %}claude{% else %}openai{% endif %}

# Multi-Model Registry (Optional, allows role-based model switching)
# Example: LLM_MODELS_JSON='{"fast": {"provider": "openai", "model": "gpt-4o-mini"}, "smart": {"provider": "azure", "deployment": "gpt-4o"}}'
LLM_MODELS_JSON=

# LLM API Authentication
LLM_API_KEY={% if llm_provider == 'openai' %}sk-proj-dummy-openai-key{% elif llm_provider == 'azure' %}dummy-azure-key{% elif llm_provider == 'deepseek' %}sk-dummy-deepseek-key{% elif llm_provider == 'gemini' %}dummy-gemini-key{% elif llm_provider == 'claude' %}sk-ant-dummy-claude-key{% else %}dummy-key{% endif %}

# LLM Endpoint Configuration
LLM_ENDPOINT={% if llm_provider == 'azure' %}https://your-resource.openai.azure.com/{% elif llm_provider == 'openai' %}https://api.openai.com/v1{% elif llm_provider == 'deepseek' %}https://api.deepseek.com{% else %}https://api.<% llm_provider %>.com/v1{% endif %}

# Azure OpenAI Specific (Required if llm_provider is 'azure')
AZURE_DEPLOYMENT_NAME={% if llm_provider == 'azure' %}gpt-4o{% else %}your-deployment-name{% endif %}

# Default Model Names
LLM_MODEL_GPT_4o={% if llm_provider == 'gemini' %}gemini-1.5-pro{% elif llm_provider == 'claude' %}claude-3-5-sonnet-20240620{% else %}gpt-4o{% endif %}
LLM_MODEL_GPT_4_1={% if llm_provider == 'claude' %}claude-3-opus-20240229{% else %}gpt-4-turbo{% endif %}

# MCP Server Configuration
AX_MCP_SERVER_URL=http://127.0.0.1:8080/mcp
AX_MCP_SERVER_API_KEY=dummy_mcp_key
AX_MCP_SERVER_NAME=aix-mcp-remote

# Tavily Search Configuration (Optional)
TAVILY_API_KEY=tvly-dummy-key

# Tracing Configuration (Optional)
PHOENIX_TRACER__ENABLED=False
PHOENIX_TRACER__ENDPOINT=http://aip.sktai.io/phoenix/v1/traces
PHOENIX_TRACER__PROJECT_NAME=<% project_name %>

# Authelia Configuration
# AUTHELIA_URL=https://auth.example.com
# AUTHELIA_INTROSPECTION_URL=http://authelia:9091/api/oidc/introspection
# AUTHELIA_TOKEN_URL=http://authelia:9091/api/oidc/token
# AUTHELIA_USERINFO_URL=http://authelia:9091/api/oidc/userinfo
# AUTHELIA_AUTHORIZATION_URL=https://auth.example.com/api/oidc/authorization
# AUTHELIA_CLIENT_ID=fastapi
# AUTHELIA_CLIENT_SECRET=your-secret
# AUTHELIA_REDIRECT_URI=http://localhost:8888/api/v1/auth/callback
