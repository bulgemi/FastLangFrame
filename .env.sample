# LLM Settings
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_ENDPOINT=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Azure OpenAI Specific
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=

# Anthropic (Claude) Specific
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=

# Google (Gemini) Specific
GOOGLE_API_KEY=

# DB Settings
REDIS_URL=
OPENSEARCH_URL=
DATABASE_URL=

# MCP Settings
MCP_SERVER_URL=
MCP_SERVER_API_KEY=
MCP_SERVER_NAME=

# Tracing
PHOENIX_ENABLED=False
PHOENIX_ENDPOINT=
PROJECT_NAME=fastlangframe-agent

# --- Authelia Configuration ---
# See docs/authelia_setup.md for details

# Authelia Secrets (Generate with: openssl rand -base64 36)
AUTHELIA_JWT_SECRET=unsecure_session_secret_change_me
AUTHELIA_HMAC_SECRET=unsecure_hmac_secret_change_me

# --- Native JWT Configuration ---
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Authelia OIDC Configuration (Back-channel only) ---
AUTHELIA_URL=http://127.0.0.1:9091
AUTHELIA_TOKEN_URL=http://127.0.0.1:9091/api/oidc/token
AUTHELIA_CLIENT_ID=fastlangframe
AUTHELIA_CLIENT_SECRET=fastlangframe_secret
