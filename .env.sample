# LLM Settings
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_ENDPOINT=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Azure OpenAI Specific
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=

# Anthropic (Claude) Specific
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=

# Google (Gemini) Specific
GOOGLE_API_KEY=

# DB Settings
REDIS_URL=
OPENSEARCH_URL=
DATABASE_URL=
DATABASE_DRIVER=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=admin
DATABASE_PASSWORD=fastlangframe1@
DATABASE_DBNAME=backend
DATABASE_SCHEMA=public

# MCP Settings
MCP_SERVER_URL=
MCP_SERVER_API_KEY=
MCP_SERVER_NAME=

# Tracing
PROJECT_NAME=fastlangframe-agent

# Langfuse Settings
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_DATABASE_URL=postgresql://admin:fastlangframe1@postgres:5432/langfuse
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=your_nextauth_secret
LANGFUSE_SALT=your_salt
LANGFUSE_TELEMETRY_ENABLED=false

# --- Native JWT Configuration ---
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

