# LLM Settings
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_ENDPOINT=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Azure OpenAI Specific
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_DEPLOYMENT_NAME=

# Anthropic (Claude) Specific
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=

# Google (Gemini) Specific
GOOGLE_API_KEY=

# DB Settings
REDIS_URL=
OPENSEARCH_URL=
DATABASE_URL=

# MCP Settings
MCP_SERVER_URL=
MCP_SERVER_API_KEY=
MCP_SERVER_NAME=

# Tracing
PHOENIX_ENABLED=False
PHOENIX_ENDPOINT=
PROJECT_NAME=fastlangframe-agent

# Authentik Docker Compose Configuration
PG_PASS=fastlangframe_db_pass
PG_USER=authentik
PG_DB=authentik
AUTHENTIK_SECRET_KEY=fastlangframe_secret_key
AUTHENTIK_BOOTSTRAP_PASSWORD=FastLangFrame1!

# Authentik OAuth Configuration
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_CLIENT_ID=your_client_id
AUTHENTIK_CLIENT_SECRET=your_client_secret
AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/fastlangframe/jwks/
AUTHENTIK_AUTH_URL=http://localhost:9000/application/o/authorize/
AUTHENTIK_TOKEN_URL=http://localhost:9000/application/o/token/
AUTHENTIK_USERINFO_URL=http://localhost:9000/application/o/userinfo/
AUTHENTIK_CALLBACK_URL=http://localhost:8501/callback
