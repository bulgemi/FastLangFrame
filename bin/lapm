#!/bin/bash

# --- FastLangFrame Project Manager (lapm) ---

# 0. 스크립트 위치 및 프로젝트 루트 확인
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
BASE_DIR="$( dirname "$SCRIPT_DIR" )"

show_help() {
    echo "Usage:"
    echo "  lapm <project_name> [create|build|deploy] [options]"
    echo ""
    echo "Commands:"
    echo "  create [llm_choice] [tpl_choice]  Generate a new project from template"
    echo "  build                             Build Docker image for the project"
    echo "  deploy                            Deploy project to Kubernetes"
    echo ""
    echo "Options:"
    echo "  -h, --help                        Show this help message"
    echo ""
    echo "Example (Create):"
    echo "  ./bin/lapm my_agent create 2 5"
    echo "  ./bin/lapm my_agent 2 5 (Legacy support)"
}

# 1. 아규먼트 체크 (도움말 포함)
if [[ "$1" == "-h" || "$1" == "--help" || -z "$1" ]]; then
    show_help
    if [[ -z "$1" ]]; then
        echo ""
        read -p "프로젝트명을 입력하세요 (또는 취소 Ctrl+C): " PROJECT_NAME
        if [ -z "$PROJECT_NAME" ]; then exit 0; fi
    else
        exit 0
    fi
else
    PROJECT_NAME="$1"
fi

COMMAND="$2"
PROJECT_DIR="$BASE_DIR/projects/$PROJECT_NAME"

# Legacy support for 'lapm {project_name} {llm_choice} {tpl_choice}'
if [[ "$COMMAND" =~ ^[1-6]$ ]]; then
    LLM_CHOICE="$COMMAND"
    TPL_CHOICE="$3"
    COMMAND="create"
else
    LLM_CHOICE="$3"
    TPL_CHOICE="$4"
fi

# Default command is 'create' if not specified
if [ -z "$COMMAND" ]; then
    COMMAND="create"
fi

case $COMMAND in
    create)
        # --- Project Creation Logic ---
        if [ -z "$LLM_CHOICE" ]; then
            echo "LLM Provider를 선택하세요: (1:openai, 2:azure, 3:deepseek, 4:gemini, 5:claude, 6:local)"
            read -p "선택 (1-6): " LLM_CHOICE
        fi
        case $LLM_CHOICE in
            1) LLM_PROVIDER="openai" ;; 2) LLM_PROVIDER="azure" ;; 3) LLM_PROVIDER="deepseek" ;;
            4) LLM_PROVIDER="gemini" ;; 5) LLM_PROVIDER="claude" ;; 6) LLM_PROVIDER="local" ;;
            *) LLM_PROVIDER="$LLM_CHOICE" ;;
        esac

        # templates 디렉토리 내의 하위 디렉토리를 동적으로 가져옴
        TEMPLATE_LIST=($(ls -d "$BASE_DIR"/templates/*/ 2>/dev/null | sed "s#$BASE_DIR/templates/##; s#/##g"))
        
        if [ -z "$TPL_CHOICE" ]; then
            echo "템플릿을 선택하세요:"
            for i in "${!TEMPLATE_LIST[@]}"; do
                echo "  $((i+1)): ${TEMPLATE_LIST[$i]}"
            done
            read -p "선택 (1-${#TEMPLATE_LIST[@]}): " TPL_CHOICE
        fi

        # 숫자가 입력된 경우 배열 인덱스로 매핑
        if [[ "$TPL_CHOICE" =~ ^[0-9]+$ ]] && [ "$TPL_CHOICE" -le "${#TEMPLATE_LIST[@]}" ] && [ "$TPL_CHOICE" -gt 0 ]; then
            TEMPLATE="${TEMPLATE_LIST[$((TPL_CHOICE-1))]}"
        else
            TEMPLATE="$TPL_CHOICE"
        fi

        TEMPLATE_DIR="$BASE_DIR/templates/$TEMPLATE"
        echo "Creating project '$PROJECT_NAME' with template '$TEMPLATE'..."
        
        # Copier check and run
        COPIER_CMD="copier"
        if ! command -v copier >/dev/null 2>&1; then
            COPIER_CMD="poetry run copier"
        fi
        
        $COPIER_CMD copy -f -d project_name="$PROJECT_NAME" -d llm_provider="$LLM_PROVIDER" "$TEMPLATE_DIR" "$PROJECT_DIR"
        
        # Copy root pyproject.toml to the new project and update its name
        cp "$BASE_DIR/pyproject.toml" "$PROJECT_DIR/$PROJECT_NAME/pyproject.toml"
        # Update name in pyproject.toml (using a platform-compatible sed)
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/^name = .*/name = \"$PROJECT_NAME\"/" "$PROJECT_DIR/$PROJECT_NAME/pyproject.toml"
        else
            sed -i "s/^name = .*/name = \"$PROJECT_NAME\"/" "$PROJECT_DIR/$PROJECT_NAME/pyproject.toml"
        fi

        # Note: Docker and K8s files are already inside the agent template <%project_name%> folder.
        # We just need to make them executable in the generated project.
        chmod +x "$PROJECT_DIR/$PROJECT_NAME/docker/docker-build.sh" "$PROJECT_DIR/$PROJECT_NAME/k8s/k8s-deploy.sh" 2>/dev/null
        echo "✅ Project created at $PROJECT_DIR"
        ;;

    build)
        # Check if project exists and find docker-build.sh
        BUILD_SCRIPT="$PROJECT_DIR/$PROJECT_NAME/docker/docker-build.sh"
        if [ ! -f "$BUILD_SCRIPT" ]; then
            echo "❌ Error: Docker build script not found at $BUILD_SCRIPT"
            exit 1
        fi
        cd "$PROJECT_DIR/$PROJECT_NAME" && ./docker/docker-build.sh
        ;;

    deploy)
        # Check if project exists and find k8s-deploy.sh
        DEPLOY_SCRIPT="$PROJECT_DIR/$PROJECT_NAME/k8s/k8s-deploy.sh"
        if [ ! -f "$DEPLOY_SCRIPT" ]; then
            echo "❌ Error: K8s deploy script not found at $DEPLOY_SCRIPT"
            exit 1
        fi
        cd "$PROJECT_DIR/$PROJECT_NAME" && ./k8s/k8s-deploy.sh
        ;;

    *)
        echo "❌ Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac
